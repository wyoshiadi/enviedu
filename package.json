{
  "name": "enviedu",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Research prototype for transfer of stock-flow reasoning across environmental contexts",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev-server.mjs",
    "start": "node --experimental-strip-types scripts/dev-server.mjs --production",
    "build": "tsc --noEmit && node scripts/build-worker.mjs",
    "build:cloudflare": "tsc --noEmit && node scripts/build-worker.mjs --cloudflare",
    "cf:dry-run": "wrangler deploy --config wrangler.example.jsonc --dry-run --outdir .artifacts/worker-dry-run",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc",
    "preview": "node --experimental-strip-types scripts/dev-server.mjs --production",
    "test": "node --experimental-strip-types --test tests/research.test.mjs tests/api.test.mjs tests/cloudflare.test.mjs tests/teacher-requests.test.mjs tests/submission-sync.test.mjs",
    "test:teacher-delete": "node tests/teacher-delete-browser.mjs",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
